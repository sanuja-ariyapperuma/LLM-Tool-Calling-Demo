@page
@{ ViewData["Title"] = "Access denied"; }
<div class="mx-auto mt-10 max-w-md card p-6">
    <h1 class="text-xl font-semibold">You do not have permission</h1>
    <p class="mt-2 text-sm text-backstage-muted">Your account can view this shop's data but not change it. Ask a Level1 admin to make the change.</p>
    <a asp-page="/Admin/Index" class="btn btn-ghost mt-4">Back to the dashboard</a>
</div>

@page "{id:int}"
@model FinGuitar.Web.Pages.Admin.Products.EditModel
@using FinGuitar.Web.Pages.Admin.Products
@{ ViewData["Title"] = $"Edit {Model.Product.Name}"; }

<a asp-page="/Admin/Products/Details" asp-route-id="@Model.Product.Id" class="text-sm text-backstage-muted hover:underline">&larr; @Model.Product.Name</a>
<h1 class="mt-1 font-display text-2xl font-semibold">Edit price and stock</h1>
<p class="mt-1 text-sm text-backstage-muted">@Model.Product.Name · @Model.Product.Brand · #@Model.Product.Id</p>

@if (ViewData.ModelState.TryGetValue("", out var general) && general.Errors.Count > 0)
{
    <div role="alert" class="mt-3 max-w-xl rounded-md border border-rose-400 bg-rose-950/40 px-3 py-2 text-sm text-rose-200">@general.Errors[0].ErrorMessage</div>
}

<form method="post" class="card mt-4 max-w-xl space-y-4 p-4 text-sm">
    <div class="grid grid-cols-2 gap-4">
        <div>
            <label asp-for="Input.Price" class="mb-1 block font-medium">Price</label>
            <input asp-for="Input.Price" type="number" step="0.01" class="input" />
            <span asp-validation-for="Input.Price" class="text-rose-300"></span>
        </div>
        <div>
            <label asp-for="Input.Stock" class="mb-1 block font-medium">Stock</label>
            <input asp-for="Input.Stock" type="number" step="1" class="input" />
            <span asp-validation-for="Input.Stock" class="text-rose-300"></span>
        </div>
    </div>
    <div class="flex gap-2">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-page="/Admin/Products/Details" asp-route-id="@Model.Product.Id" class="btn btn-ghost">Cancel</a>
    </div>
</form>

@page "{id:int}"
@model FinGuitar.Web.Pages.Admin.Products.DetailsModel
@using FinGuitar.Web.Pages.Admin.Products
@{
    var p = Model.Product;
    ViewData["Title"] = p.Name;
}

<a asp-page="/Admin/Products/Index" class="text-sm text-backstage-muted hover:underline">&larr; All products</a>
<div class="mt-1 flex items-center justify-between">
    <h1 class="font-display text-2xl font-semibold">@p.Name <span class="text-sm font-normal text-backstage-muted">#@p.Id</span></h1>
    @if (User.IsInRole(Roles.Level1))
    {
        <a asp-page="/Admin/Products/Edit" asp-route-id="@p.Id" class="btn btn-primary">Edit price and stock</a>
    }
</div>

@if (Model.Message is not null)
{
    <div role="status" class="mt-3 rounded-md border border-emerald-500 bg-emerald-950/40 px-3 py-2 text-sm text-emerald-200">@Model.Message</div>
}

<div class="mt-4 grid gap-4 md:grid-cols-3">
    <img src="@p.ImageUrl" alt="@p.Name" class="card w-full object-cover md:col-span-1" style="aspect-ratio: 4 / 3" />
    <section class="card p-4 text-sm md:col-span-2" aria-labelledby="info-h">
        <h2 id="info-h" class="font-semibold">Details</h2>
        <dl class="mt-2 grid grid-cols-2 gap-y-2">
            <dt class="text-backstage-muted">Brand</dt><dd>@p.Brand</dd>
            <dt class="text-backstage-muted">Category</dt><dd>@p.Category</dd>
            <dt class="text-backstage-muted">Price</dt><dd class="tabular-nums">@UiHelpers.Money(p.Price)</dd>
            <dt class="text-backstage-muted">Stock</dt>
            <dd class="tabular-nums">@p.Stock
                @if (p.Stock == 0) { <span class="badge badge-cancelled">Out of stock</span> }
                else if (p.IsLowStock) { <span class="badge badge-pending">Low</span> }
            </dd>
        </dl>
    </section>
</div>

<section class="card mt-4 p-4 text-sm" aria-labelledby="hist-h">
    <div class="flex items-center justify-between">
        <h2 id="hist-h" class="font-semibold">History</h2>
        <a class="text-sunburst underline" asp-page="/Admin/Audit/Index" asp-route-entityType="Product" asp-route-entityId="@p.Id">All changes to this product</a>
    </div>
    @if (Model.History.Count == 0)
    {
        <p class="mt-2 text-backstage-muted">No changes have been made to this product yet.</p>
    }
    else
    {
        <ul class="mt-2 space-y-1">
            @foreach (var h in Model.History)
            {
                <li>@UiHelpers.Stamp(h.OccurredAt) · @h.UserEmail · @h.Summary · <span class="text-backstage-muted">@UiHelpers.SourceLabel(h.Source)</span></li>
            }
        </ul>
    }
</section>

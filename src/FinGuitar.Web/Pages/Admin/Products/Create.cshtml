@page
@model FinGuitar.Web.Pages.Admin.Products.CreateModel
@using FinGuitar.Web.Pages.Admin.Products
@{ ViewData["Title"] = "New product"; }

<a asp-page="/Admin/Products/Index" class="text-sm text-backstage-muted hover:underline">&larr; All products</a>
<h1 class="mt-1 font-display text-2xl font-semibold">New product</h1>
<p class="mt-1 text-sm text-backstage-muted">New products get a placeholder photo. Photo upload is not part of this demo.</p>

<form method="post" class="card mt-4 max-w-xl space-y-4 p-4 text-sm">
    <div>
        <label asp-for="Input.Name" class="mb-1 block font-medium">Name</label>
        <input asp-for="Input.Name" class="input" />
        <span asp-validation-for="Input.Name" class="text-rose-300"></span>
    </div>
    <div>
        <label asp-for="Input.Brand" class="mb-1 block font-medium">Brand</label>
        <input asp-for="Input.Brand" class="input" />
        <span asp-validation-for="Input.Brand" class="text-rose-300"></span>
    </div>
    <div>
        <label asp-for="Input.Category" class="mb-1 block font-medium">Category</label>
        <select asp-for="Input.Category" class="input">
            @foreach (var c in ProductService.Categories) { <option value="@c" selected="@(c == Model.Input.Category)">@c</option> }
        </select>
        <span asp-validation-for="Input.Category" class="text-rose-300"></span>
    </div>
    <div class="grid grid-cols-2 gap-4">
        <div>
            <label asp-for="Input.Price" class="mb-1 block font-medium">Price</label>
            <input asp-for="Input.Price" type="number" step="0.01" class="input" />
            <span asp-validation-for="Input.Price" class="text-rose-300"></span>
        </div>
        <div>
            <label asp-for="Input.Stock" class="mb-1 block font-medium">Stock</label>
            <input asp-for="Input.Stock" type="number" step="1" class="input" />
            <span asp-validation-for="Input.Stock" class="text-rose-300"></span>
        </div>
    </div>
    <div class="flex gap-2">
        <button type="submit" class="btn btn-primary">Create product</button>
        <a asp-page="/Admin/Products/Index" class="btn btn-ghost">Cancel</a>
    </div>
</form>

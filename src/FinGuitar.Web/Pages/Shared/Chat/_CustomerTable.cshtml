@using FinGuitar.Web.Chat
@model CustomerTablePayload
<div class="mt-3 overflow-x-auto">
    @if (Model.Rows.Count == 0)
    {
        <p class="text-backstage-muted">No customers found.</p>
    }
    else
    {
        <table class="data-table">
            <thead><tr><th>Customer</th><th>Email</th><th>Phone</th><th class="num">Orders</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td><a class="text-sunburst underline" href="/Admin/Customers/Details/@r.Id">@r.Name</a> <span class="text-xs text-backstage-muted">#@r.Id</span></td>
                    <td>@r.Email</td>
                    <td>@r.Phone</td>
                    <td class="num">@r.OrderCount</td>
                </tr>
            }
            </tbody>
        </table>
        <p class="mt-2 text-xs text-backstage-muted">Showing @Model.Rows.Count of @Model.TotalCount</p>
    }
</div>

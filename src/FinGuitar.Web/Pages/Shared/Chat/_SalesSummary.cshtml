@using FinGuitar.Web.Chat
@model SalesSummaryPayload
<div class="mt-3 grid grid-cols-2 gap-3 sm:max-w-md">
    <div class="rounded-md border border-backstage-line p-3"><div class="text-xs uppercase tracking-wide text-backstage-muted">Revenue</div><div class="text-xl font-semibold tabular-nums">@UiHelpers.Money(Model.Revenue)</div></div>
    <div class="rounded-md border border-backstage-line p-3"><div class="text-xs uppercase tracking-wide text-backstage-muted">Orders</div><div class="text-xl font-semibold tabular-nums">@Model.OrderCount</div></div>
    <p class="col-span-2 text-xs text-backstage-muted">@Model.From to @Model.To, not counting cancelled orders</p>
</div>

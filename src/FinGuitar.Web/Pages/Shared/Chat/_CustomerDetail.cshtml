@using FinGuitar.Web.Chat
@model CustomerDetailPayload
<div class="mt-3 rounded-md border border-backstage-line p-3">
    <a class="font-semibold text-sunburst underline" href="/Admin/Customers/Details/@Model.Id">@Model.Name</a>
    <p class="text-backstage-muted">@Model.Email · @Model.Phone · @Model.Address</p>
    @if (Model.Orders.Count > 0)
    {
        <div class="mt-2 overflow-x-auto">
            <table class="data-table">
                <thead><tr><th>Order</th><th>Date</th><th>Items</th><th>Status</th><th class="num">Total</th></tr></thead>
                <tbody>
                @foreach (var r in Model.Orders)
                {
                    <tr>
                        <td><a class="text-sunburst underline" href="/Admin/Orders/Details/@r.Id">#@r.Id</a></td>
                        <td class="whitespace-nowrap">@r.Date</td>
                        <td>@r.Items</td>
                        <td><span class="@UiHelpers.StatusBadge(Enum.Parse<OrderStatus>(r.Status))">@r.Status</span></td>
                        <td class="num">@UiHelpers.Money(r.Total)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
